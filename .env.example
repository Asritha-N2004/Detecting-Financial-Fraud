# Copy to .env in the repository root for Docker, or backend/.env for local Python.
JWT_SECRET=
DATABASE_URL=sqlite:///./risk.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
MODEL_PROVIDER=deterministic
# LLM interpretation is independently opt-in; numerical scores remain Python-only.
SPECIALIST_PROVIDER=deterministic
# SPECIALIST_MODEL=your-structured-output-compatible-model
# SPECIALIST_MODELS={"credit":"your-credit-model","market":"your-market-model"}
# AGENT_PROMPTS_DIR=/absolute/path/to/administrator-owned/prompts
LLM_MAX_TOOL_ROUNDS=3
LLM_MAX_COMPLETION_TOKENS=2000
WORKER_ENABLED=true
WORKER_POLL_SECONDS=0.5
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=3
JOB_RETRY_SECONDS=2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://your-compatible-provider.example/v1
AGENT_TIMEOUT_SECONDS=30
AGENT_RETRIES=1
UPLOAD_LIMIT_BYTES=2000000
# Docker PostgreSQL password must be set independently.
POSTGRES_PASSWORD=
